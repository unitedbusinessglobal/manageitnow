# --- App ---
APP_URL=http://localhost:3000
APP_ENV=dev                      # dev | qa | uat | prod
DEFAULT_LOCALE=en

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Auth ---
JWT_SECRET=change-me
ADMIN_EMAILS=unitedbusinessglobal@gmail.com   # comma-separated platform admins

# --- Billing (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# --- GST (our legal entity) ---
SUPPLIER_GSTIN=33XXXXXXXXXXXZX   # first 2 digits = state code (33 = Tamil Nadu)
SUPPLIER_LEGAL_NAME=Your Company Pvt Ltd
GST_RATE_PERCENT=18
SAC_CODE=998314

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_ACCESS_TOKEN=xxx

# --- AI (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Integrations ---
GITHUB_WEBHOOK_SECRET=xxx
TESTITNOW_WEBHOOK_SECRET=xxx
LEADITNOW_API_URL=
LEADITNOW_API_KEY=
